  name varchar [not null]          // 'SaaS ATS', 'On-demand Staffing'
  plan_tier varchar                // Free | Enterprise | ...
  billing_cycle varchar
  seat_count int
  status varchar
  Indexes { customer_id }
  Note: 'DEFERRED — schema stub. Confirm fields when "Gói dịch vụ" screens land.'
}

Table customer_wallet {
  id bigint [pk, increment]
  customer_id bigint [unique, not null]
  balance bigint [not null, default: 0]
  payout_method varchar
  Note: 'DEFERRED — "Ví công ty". Stub.'
}

Table wallet_transaction {
  id bigint [pk, increment]
  wallet_id bigint [not null]
  at timestamptz [not null, default: `now()`]
  amount bigint [not null]         // signed
  kind varchar                     // topup | spend | refund
  reference varchar
  Indexes { wallet_id }
  Note: 'DEFERRED — stub.'
}

Ref: service_package.customer_id > customer.id
Ref: customer_wallet.customer_id > customer.id
Ref: wallet_transaction.wallet_id > customer_wallet.id
